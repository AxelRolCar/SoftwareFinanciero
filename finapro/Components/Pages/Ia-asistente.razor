@page "/ia-asistente"

<div class="container h-100 d-flex flex-column" style="max-height: 80vh;">
    <h3>Asistente IA Financiero</h3>
    <div class="flex-grow-1 bg-white border rounded p-3 mb-3 shadow-sm overflow-auto">
        <div class="mb-3 text-start">
            <div class="d-inline-block p-2 bg-light rounded text-dark small" style="max-width: 80%;">
                ¡Hola! Soy tu asistente. ¿Quieres que analicemos tus gastos de este mes?
            </div>
        </div>
    </div>
    <div class="input-group">
        <input type="text" class="form-control" placeholder="Escribe tu duda financiera..." />
        <button class="btn btn-primary">Preguntar</button>
    </div>
</div>