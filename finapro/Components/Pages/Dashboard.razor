@page "/dashboard"

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Panel de Control</h3>
        <select class="form-select w-auto">
            <option>Mes Actual</option>
            <option>Mes Anterior</option>
            <option>Año Actual</option>
        </select>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-success border-4 p-3">
                <span class="text-muted small fw-bold">INGRESOS</span>
                <h3 class="text-success">$0.00</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-danger border-4 p-3">
                <span class="text-muted small fw-bold">GASTOS</span>
                <h3 class="text-danger">$0.00</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm border-start border-info border-4 p-3">
                <span class="text-muted small fw-bold">UTILIDAD NETA</span>
                <h3 class="text-info">$0.00</h3>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8 mb-4">
            <div class="card shadow-sm p-4 h-100">
                <h5>Flujo de Caja (12 meses)</h5>
                <div class="bg-light d-flex align-items-end justify-content-around" style="height: 250px;">
                    @for (int i = 0; i < 12; i++)
                    {
                        <div class="bg-primary opacity-25" style="width: 30px; height: @(i * 15 + 20)px;"></div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm p-4 h-100 text-center">
                <h5>Gastos por Categoría</h5>
                <div class="rounded-circle border border-5 border-light mx-auto my-auto d-flex align-items-center justify-content-center"
                     style="width: 200px; height: 200px; background: conic-gradient(#0d6efd 40%, #ffc107 0 70%, #dc3545 0);">
                    <div class="bg-white rounded-circle" style="width: 120px; height: 120px; display: flex; align-items: center; justify-content: center;">
                        <strong>Total</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>