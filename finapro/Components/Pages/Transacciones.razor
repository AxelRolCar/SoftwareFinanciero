@page "/transacciones"
@inject finapro.Data.DataService DB
@using finapro.Models

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Mis Transacciones</h3>
        <button class="btn btn-primary" @onclick="AbrirModalNuevo">
            <i class="bi bi-plus-circle"></i> Nueva Transacción
        </button>
        <button class="btn btn-outline-primary" @onclick="AbrirModalCategorias">
            <i class="bi bi-tags"></i> Administrar Categorías
        </button>
    </div>

    

    <div class="table-responsive">
        <table class="table table-hover table-bordered bg-white shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Fecha</th>
                    <th>Concepto</th>
                    <th>Categoría</th>
                    <th>Método de Pago</th>
                    <th>Facturada</th>
                    <th>Monto</th>
                    <th>Tipo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (listaTransacciones == null || listaTransacciones.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted">No hay transacciones registradas.</td></tr>
                }
                else
                {
                    @foreach (var t in listaTransacciones)
                    {
                        <tr>
                            <td>@t.fecha.ToString("dd/MM/yyyy")</td>
                            <td>@t.concepto</td>
                            <td><span class="badge bg-secondary">@t.nombreCategoria</span></td>
                            <td>@t.metodoPago</td>
                            <td>
                                @if (t.estaFacturada)
                                {
                                    <small class="text-muted"><i class="bi bi-file-text"></i> @t.idFactura</small>
                                }
                                else
                                {

                                    <span class="text-muted">No</span>
                                }
                            </td>
                            <td class="fw-bold @(t.tipo == "Ingreso" ? "text-success" : "text-danger")">
                                $@t.monto.ToString("N2")
                            </td>
                            <td>@t.tipo</td>
                            <td>
                                <button class="btn btn-sm btn-outline-warning me-1" @onclick="() => AbrirModalEditar(t)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Borrar(t.id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (mostrarModal)
    {
        <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@(transaccionActual.id == 0 ? "Nueva Transacción" : "Editar Transacción")</h5>
                        <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="form-label small">Tipo</label>
                            <select class="form-select" @bind="transaccionActual.tipo">
                                <option value="Ingreso">Ingreso</option>
                                <option value="Gasto">Gasto</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small">Concepto</label>
                            <input type="text" class="form-control" @bind="transaccionActual.concepto" placeholder="Ej. Venta de software" />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label small">Monto ($)</label>
                                <input type="number" step="0.01" class="form-control" @bind="transaccionActual.monto" />
                            </div>
                            <div class="col-md-6 mb-2">
                                <label class="form-label small">Fecha</label>
                                <input type="date" class="form-control" @bind="transaccionActual.fecha" />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label small">Categoría</label>
                            <select class="form-select" @bind="transaccionActual.idCategoria">
                                <option value="0">Selecciona una...</option>
                                @foreach (var c in listaCategorias.Where(x => x.tipo == transaccionActual.tipo))
                                {
                                    <option value="@c.id">@c.nombre</option>
                                }
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <label class="form-label small">Método de Pago</label>
                                <select class="form-select" @bind="transaccionActual.metodoPago">
                                    <option value="Efectivo">Efectivo</option>
                                    <option value="Transferencia">Transferencia</option>
                                    <option value="Tarjeta">Tarjeta de Crédito/Débito</option>
                                </select>
                            </div>
                            <div class="col-md-6 mb-2 d-flex align-items-end">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="transaccionActual.estaFacturada" id="chkFacturada">
                                    <label class="form-check-label small" for="chkFacturada">
                                        Genera Factura
                                    </label>
                                </div>
                                @if (transaccionActual.estaFacturada)
                                {
                                    <div class="mb-3 animate__animated animate__fadeIn">
                                        <label class="form-label small fw-bold">Folio de Factura</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text"><i class="bi bi-file-earmark-text"></i></span>
                                            <input type="text" class="form-control" @bind="transaccionActual.idFactura" placeholder="Ej. A-150" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                        <button type="button" class="btn btn-success" @onclick="Guardar">Guardar</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (mostrarModalCats)
{
    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Administrar Categorías</h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalCats = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        @foreach (var tipo in new[] { "Ingreso", "Gasto" })
                        {
                            <div class="col-md-6 border-end">
                                <h6 class="text-center fw-bold @(tipo == "Ingreso" ? "text-success" : "text-danger")">@tipo</h6>
                                <div class="input-group mb-2">
                                    <input type="text" class="form-control form-control-sm" placeholder="Nueva categoría..."
                                           @bind="nombresNuevasCats[tipo]" />
                                    <button class="btn btn-sm btn-primary" @onclick="() => AgregarCat(tipo)">+</button>
                                </div>
                                <ul class="list-group list-group-flush overflow-auto" style="max-height: 200px;">
                                    @foreach (var cat in listaCategorias.Where(x => x.tipo == tipo))
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center py-1">
                                            <span class="small">@cat.nombre</span>
                                            <button class="btn btn-sm text-danger" @onclick="() => BorrarCat(cat.id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // IMPORTANTE: Aquí simulamos que el usuario tiene abierta su empresa número 1.
    int empresaActivaId = 1;

    List<Transaccion> listaTransacciones = new();
    List<Categoria> listaCategorias = new();
    Transaccion transaccionActual = new Transaccion();
    bool mostrarModal = false;

    protected override void OnInitialized()
    {
        // Al cargar la página, traemos los datos de la base de datos
        CargarDatos();
        listaCategorias = DB.ObtenerCategorias();
    }

    void CargarDatos()
    {
        listaTransacciones = DB.ObtenerTransacciones(empresaActivaId);
    }

    void AbrirModalNuevo()
    {
        // Limpiamos el objeto para crear uno nuevo asociado a la empresa activa
        transaccionActual = new Transaccion { idEmpresa = empresaActivaId, fecha = DateTime.Now };
        mostrarModal = true;
    }

    void AbrirModalEditar(Transaccion t)
    {
        // Clonamos los datos para no modificar la lista en vivo si el usuario cancela
        transaccionActual = new Transaccion
        {
            id = t.id,
            idEmpresa = t.idEmpresa,
            idCategoria = t.idCategoria,
            fecha = t.fecha,
            concepto = t.concepto,
            monto = t.monto,
            tipo = t.tipo,
            metodoPago = t.metodoPago,
            estaFacturada = t.estaFacturada
        };
        mostrarModal = true;
    }

    void CerrarModal()
    {
        mostrarModal = false;
    }

    void Guardar()
    {
        if (string.IsNullOrWhiteSpace(transaccionActual.concepto) || transaccionActual.idCategoria == 0 || transaccionActual.monto <= 0)
        {
            // Aquí podrías agregar un mensaje de error o validación visual
            return;
        }

        DB.GuardarTransaccion(transaccionActual);
        mostrarModal = false;
        CargarDatos(); // Recargamos la tabla
    }

    void Borrar(int id)
    {
        DB.EliminarTransaccion(id, empresaActivaId);
        CargarDatos(); // Recargamos la tabla
    }

    bool mostrarModalCats = false;
    // Diccionario para manejar el texto de los dos inputs (Ingreso/Gasto) por separado
    Dictionary<string, string> nombresNuevasCats = new() { { "Ingreso", "" }, { "Gasto", "" } };

    void AbrirModalCategorias()
    {
        listaCategorias = DB.ObtenerCategorias(); // Refrescar lista
        mostrarModalCats = true;
    }

    void AgregarCat(string tipo)
    {
        if (!string.IsNullOrWhiteSpace(nombresNuevasCats[tipo]))
        {
            var nueva = new Categoria { nombre = nombresNuevasCats[tipo], tipo = tipo };
            DB.InsertarCategoria(nueva);
            nombresNuevasCats[tipo] = ""; // Limpiar input
            listaCategorias = DB.ObtenerCategorias(); // Refrescar vista
        }
    }

    void BorrarCat(int id)
    {
        try
        {
            DB.EliminarCategoria(id);
            listaCategorias = DB.ObtenerCategorias();
        }
        catch
        {
            // Aquí podrías mostrar un error si la categoría está en uso
        }
    }
}