@page "/educacion"

<div class="container">
    <h3>Camino de Aprendizaje</h3>
    
    <div class="mb-5 mt-4">
        <div class="d-flex justify-content-between mb-1">
            <span>Nivel: <strong>Inicio</strong></span>
            <span>40% Completado</span>
        </div>
        <div class="progress" style="height: 10px;">
            <div class="progress-bar bg-info" style="width: 40%"></div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body">
                    <div class="text-primary mb-2"><span class="oi oi-media-play"></span></div>
                    <h5>Control de Costos</h5>
                    <p class="small text-muted">Aprende a diferenciar entre costos fijos y variables.</p>
                    <button class="btn btn-sm btn-primary">Ver Lección</button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 opacity-75">
                <div class="card-body">
                    <div class="text-muted mb-2"><span class="oi oi-lock-locked"></span></div>
                    <h5>Gestión de Impuestos</h5>
                    <p class="small text-muted">Disponible al completar el nivel inicial.</p>
                </div>
            </div>
        </div>
    </div>
</div>